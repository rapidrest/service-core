{
    "name": "@rapidrest/service-core",
    "version": "1.5.0",
    "description": "Provides all core functionality for RapidREST based backend services.",
    "repository": "https://github.com/rapidrest/service-core.git",
    "author": "RapidREST <rapidrests@gmail.com>",
    "license": "MPL-2.0",
    "contributors": [
        "Jean-Philippe Steinmetz",
        "Arthur Thompson",
        "Thomas Buscaglia"
    ],
    "scripts": {
        "build": "yarn lint && rimraf dist && tsc",
        "lint": "eslint ./src ./test",
        "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
        "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
        "dependency-check": "yarn dlx depcheck \"$@\"",
        "bench": "tsx bench/index.ts",
        "bench:baseline": "yarn bench 2>&1 | tee bench/baseline.txt",
        "test": "vitest run",
        "test:prod": "yarn lint && vitest run --coverage",
        "test:watch": "vitest",
        "release": "rapidrest release"
    },
    "dependencies": {
        "axios": "^1.20.0",
        "dayjs": "^1.11.23",
        "deepmerge": "^4.3.1",
        "node-schedule": "^2.1.1",
        "winston-transport": "^4.9.0",
        "ws": "^8.21.3"
    },
    "optionalDependencies": {
        "uWebSockets.js": "uNetworking/uWebSockets.js#v20.69.0"
    },
    "peerDependencies": {
        "@rapidrest/core": "5.x",
        "lodash-es": "4.x",
        "mongodb": "^7.0.0",
        "openapi3-ts": "4.x",
        "prom-client": "15.x",
        "redis": "6.x",
        "reflect-metadata": "0.2.x",
        "typeorm": "1.1.x",
        "uWebSockets.js": "*",
        "winston": "3.x"
    },
    "peerDependenciesMeta": {
        "mongodb": {
            "optional": true
        },
        "typeorm": {
            "optional": true
        },
        "uWebSockets.js": {
            "optional": true
        }
    },
    "devDependencies": {
        "@rapidrest/cli": "^1.0.1",
        "@rapidrest/core": "^5.2.0",
        "@simplewebauthn/server": "^14.0.1",
        "@swc/core": "^1.16.2",
        "@types/better-sqlite3": "^9.6.0",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.5.0",
        "@types/node-schedule": "^2.1.8",
        "@types/rimraf": "^4.0.5",
        "@types/semver": "^7.8.0",
        "@types/speakeasy": "^2.0.10",
        "@types/uuid": "^11.0.0",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vitest/coverage-v8": "^5.0.0",
        "autocannon": "^8.0.0",
        "better-sqlite3": "^13.0.3",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^64.3.6",
        "globals": "^17.12.0",
        "lodash-es": "^4.18.1",
        "mongodb": "^7.6.0",
        "mongodb-memory-server": "^11.2.0",
        "nconf": "^0.13.0",
        "nock": "^14.0.17",
        "openapi3-ts": "^4.6.1",
        "pg": "^8.23.0",
        "prom-client": "^15.1.3",
        "redis": "^6.2.1",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "semver": "^7.8.5",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.13",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.13.0",
        "typeorm": "^1.1.1",
        "typescript": "^6.0.3",
        "unplugin-swc": "^1.6.0",
        "uuid": "^14.0.2",
        "vitest": "^5.0.0",
        "winston": "^3.19.0",
        "ws": "^8.21.3"
    },
    "resolutions": {
        "cross-spawn": "^7.0.5",
        "uuid@npm:^8.3.2": "^11.1.1"
    },
    "packageManager": "yarn@4.5.3",
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/lib/index.js",
    "exports": {
        ".": {
            "import": "./dist/lib/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./test": {
            "import": "./dist/lib/test/index.js",
            "types": "./dist/types/test/index.d.ts"
        },
        "./tsconfig": "./tsconfig.export.json"
    },
    "typings": "dist/types/index.d.ts",
    "files": [
        "dist",
        "docs",
        "tsconfig.export.json"
    ]
}
