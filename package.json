{
    "name": "@rapidrest/service-core",
    "version": "1.0.0-rc.24",
    "description": "Provides all core functionality for RapidREST based backend services.",
    "repository": "https://github.com/rapidrest/service-core.git",
    "author": "RapidREST <rapidrests@gmail.com>",
    "license": "MIT",
    "contributors": [
        "Jean-Philippe Steinmetz",
        "Arthur Thompson",
        "Thomas Buscaglia"
    ],
    "scripts": {
        "build": "yarn lint && rimraf dist && tsc",
        "lint": "eslint ./src ./test",
        "local-audit": "yarn install && yarn npm audit -A -R \"$@\"",
        "checkup": "yarn dlx @yarnpkg/doctor \"$@\"",
        "dependency-check": "yarn dlx depcheck \"$@\"",
        "report-coverage": "cat ./coverage/lcov.info | coveralls",
        "bench": "tsx bench/index.ts",
        "bench:baseline": "yarn bench 2>&1 | tee bench/baseline.txt",
        "test": "vitest run",
        "test:prod": "npm run lint && vitest run --coverage",
        "test:watch": "vitest",
        "postversion": "git push && git push --tags"
    },
    "dependencies": {
        "axios": "^1.17.0",
        "dayjs": "^1.11.21",
        "deepmerge": "^4.3.1",
        "node-schedule": "^2.1.1",
        "winston-transport": "^4.9.0",
        "ws": "^8.21.0"
    },
    "optionalDependencies": {
        "uWebSockets.js": "uNetworking/uWebSockets.js#v20.68.0"
    },
    "peerDependencies": {
        "@rapidrest/core": "1.x",
        "ioredis": "5.x",
        "lodash-es": "4.x",
        "mongodb": "^7.0.0",
        "openapi3-ts": "4.x",
        "prom-client": "15.x",
        "reflect-metadata": "0.2.x",
        "typeorm": "0.3.x",
        "uWebSockets.js": "*",
        "winston": "3.x"
    },
    "peerDependenciesMeta": {
        "ioredis": {
            "optional": true
        },
        "mongodb": {
            "optional": true
        },
        "typeorm": {
            "optional": true
        },
        "uWebSockets.js": {
            "optional": true
        }
    },
    "devDependencies": {
        "@rapidrest/core": "^1.8.0",
        "@simplewebauthn/server": "^13.3.2",
        "@swc/core": "^1.15.41",
        "@types/bun": "^1.3.14",
        "@types/ioredis-mock": "^8.2.7",
        "@types/node": "^25.9.2",
        "@types/node-schedule": "^2.1.8",
        "@types/rimraf": "^4.0.5",
        "@types/speakeasy": "^2",
        "@types/sqlite3": "^5.1.0",
        "@types/uuid": "^11.0.0",
        "@types/ws": "^8.18.1",
        "@typescript-eslint/eslint-plugin": "^8.61.0",
        "@typescript-eslint/parser": "^8.61.0",
        "@vitest/coverage-v8": "^4.1.8",
        "autocannon": "^8.0.0",
        "coveralls": "^3.1.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^63.0.2",
        "globals": "^17.6.0",
        "ioredis": "^5.11.1",
        "ioredis-mock": "^8.13.1",
        "lodash-es": "^4.18.1",
        "mongodb": "^7.3.0",
        "mongodb-memory-server": "^11.2.0",
        "nconf": "^0.13.0",
        "nock": "^14.0.16",
        "openapi3-ts": "^4.6.0",
        "pg": "^8.21.0",
        "prom-client": "^15.1.3",
        "reflect-metadata": "^0.2.2",
        "rimraf": "^6.1.3",
        "sqlite3": "^6.0.1",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.3",
        "typedoc": "^0.28.19",
        "typedoc-plugin-markdown": "^4.12.0",
        "typeorm": "^0.3.20",
        "typescript": "^6.0.3",
        "unplugin-swc": "^1.5.9",
        "uuid": "^14.0.0",
        "vitest": "^4.1.8",
        "winston": "^3.19.0",
        "ws": "^8.21.0"
    },
    "resolutions": {
        "cross-spawn": "^7.0.5"
    },
    "packageManager": "yarn@4.5.3",
    "engines": {
        "node": ">=24.0.0"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org/"
    },
    "type": "module",
    "main": "dist/lib/index.js",
    "exports": {
        ".": {
            "import": "./dist/lib/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./test": {
            "import": "./dist/lib/test/index.js",
            "types": "./dist/types/test/index.d.ts"
        },
        "./tsconfig": "./tsconfig.export.json"
    },
    "typings": "dist/types/index.d.ts",
    "files": [
        "dist",
        "docs",
        "tsconfig.export.json"
    ]
}
